; Engine configuration file.
; ASH&LEAD - tactical neon-noir top-down action.
config_version=5

[application]

config/name="ASH&LEAD"
config/description="Неонуарный тактический экшен с видом сверху: преступники против стражей правопорядка."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

SettingsManager="*res://autoload/settings_manager.gd"
InputManager="*res://autoload/input_manager.gd"
Localization="*res://autoload/localization.gd"
AudioManager="*res://autoload/audio_manager.gd"
ProfileManager="*res://autoload/profile_manager.gd"
Game="*res://autoload/game.gd"
NetManager="*res://autoload/net_manager.gd"

[debug]

gdscript/warnings/enable=true
gdscript/warnings/integer_division=1
gdscript/warnings/return_value_discarded=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="civilian"
2d_physics/layer_5="cover"
2d_physics/layer_6="interact"
2d_physics/layer_7="bullet"
2d_physics/layer_8="npc"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=1
2d/shadow_atlas/size=2048
2d/shadow_atlas/quadrant_0/subdivision=1
2d/shadow_atlas/quadrant_1/subdivision=1
2d/shadow_atlas/quadrant_2/subdivision=1
2d/shadow_atlas/quadrant_3/subdivision=1
environment/defaults/default_clear_color=Color(0.015, 0.017, 0.022, 1)
